# Admin access + no room for error.
# A human grants admin to the AI. The AI then uses the computer's
# full resources — and every step is checked.

link Ahmad as human
link Alya as ai
link Server as computer

# Only a human can grant admin. Ahmad grants it to every AI agent.
grant admin to all ai
say admins()

# No room for error: every step is checked, commands retry on failure,
# and the program reports exactly what happened at the end.
no room

speak as Alya
let files = list "."
say files
check len(files) > 0

let answer = run "echo hello from the computer"
say answer
check answer is "hello from the computer"

save "Admin test passed." to "admin-test.txt"
check read "admin-test.txt" is "Admin test passed."
delete "admin-test.txt"
say "All checks passed."
